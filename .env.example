POSTGRES_USER=otus
POSTGRES_PASSWORD=otus
POSTGRES_DB=graphrag_poc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://otus:otus@localhost:5432/graphrag_poc

HF_TOKEN=
HF_DATASET_REPO=irlspbru/RFSD

DATA_DIR=data
RANDOM_SEED=42

# Backend / GraphRAG
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
VECTOR_TOP_K=3
GRAPH_EXPAND_HOPS=1
API_HOST=0.0.0.0
API_PORT=8000
DEMO_INN=
# RUN_INTEGRATION=1  # enable tests/backend integration tests against live DB

# Observability (OpenTelemetry → otel-collector → Jaeger)
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=graphrag-poc
JSON_LOGS=true
