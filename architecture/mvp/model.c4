model {

  // ─── Акторы ───────────────────────────────────────────────────────────────

  creditAnalyst = actor 'Кредитный аналитик' {
    description 'Сотрудник банка, анализирует кредитные риски компаний'
    -> creditPlatform                                        'использует систему'
    -> creditPlatform.graphragRuntime.apiGateway             'HTTPS запрос'
    -> creditPlatform.graphragRuntime.apiGateway.apiLayer    'POST /ask {query, role}'
  }

  complianceOfficer = actor 'Сотрудник комплаенс' {
    description 'Проверяет соответствие запросов и ответов системы'
    -> creditPlatform          'аудит и мониторинг'
    -> creditPlatform.security 'просмотр audit log, политик доступа'
  }

  mlEngineer = actor 'ML / MLOps инженер' {
    description '
      Отвечает за качество моделей, эксперименты, версионирование
      LLM / embeddings / reranker и регрессионные прогоны.
    '
    -> creditPlatform.aiQuality 'эксперименты, регрессия, реестр моделей'
  }

  platformOps = actor 'SRE / DevOps инженер' {
    description 'Эксплуатация платформы: наблюдаемость, релизы, бэкапы.'
    -> creditPlatform.observability 'мониторинг, алерты, восстановление'
    -> deliveryPlatform             'релизы и откаты'
  }

  // ─── Внешние системы ────────────────────────────────────────────────────────

  legalCorpus = external-system 'Нормативная база банка' {
    description '
      Реальный юридический корпус: ЦБ РФ, Базель III, внутренние политики.
      Загружается через согласованный с Дирекцией права ETL.
      PoC: синтетика РФСД.
    '
  }

  financialSources = external-system 'Источники финансовой отчётности' {
    description '
      Внешние и внутренние источники финансовой отчётности контрагентов
      (РСБУ/МСФО, СПАРК-подобные витрины, внутренние выгрузки).
    '
  }

  corporateIam = external-system 'Корпоративная IAM / SSO' {
    description '
      Корпоративный провайдер идентификации (Active Directory / OIDC).
      Источник пользователей и ролей для RBAC платформы.
    '
    -[async]-> creditPlatform.security 'роли пользователей (OIDC)'
  }

  // ─── AI-платформа кредитного анализа ─────────────────────────────────────────

  creditPlatform = system 'AI-платформа кредитного анализа' {
    description '
      Production-ready Secure GraphRAG платформа банка.
      Единая система с подсистемами: рабочий контур, пополнение базы знаний,
      качество и MLOps, безопасность и доступ, наблюдаемость и надёжность.
      Self-hosted Qwen (vLLM) + Triton (embeddings/reranker) + Neo4j + Qdrant
      + HashiCorp Vault + OTel. Целевая архитектура MVP (Q1-Q3 2027).
    '

    // ═══ Подсистема 1: Secure GraphRAG Runtime ════════════════════════════════

    graphragRuntime = subsystem 'Secure GraphRAG Runtime' {
      description '
        Production online-контур: принимает вопрос аналитика, ищет контекст,
        расширяет через граф, фильтрует по ролям, ранжирует и вызывает LLM.
        FastAPI строго I/O-bound; тяжёлый инференс изолирован в vLLM и Triton.
      '

      -> creditPlatform.security 'RBAC policy evaluation (OPA) + audit events'

      apiGateway = container 'FastAPI Backend (API Gateway)' {
        technology 'Python 3.11, FastAPI, uvicorn'
        description '
          HTTP-транспорт: принимает REST-запросы, маршрутизирует в RAG Orchestrator.
          Строго I/O-bound, без бизнес-логики пайплайна.
          Ingress/mTLS через bank ingress controller. ADR-008, ADR-011.
        '
        icon tech:python

        apiLayer = component 'API Layer' {
          technology 'FastAPI'
          description '
            POST /ask — {query, role} → {answer, citations, trace_id, blocked}.
            GET /health · GET /metrics.
          '
          -> creditPlatform.graphragRuntime.ragOrchestrator 'invoke pipeline(state)'
        }
      }

      ragOrchestrator = container 'RAG Pipeline Orchestrator' {
        technology 'Python 3.11, LangGraph'
        description '
          Ядро RAG: владеет LangGraph StateGraph-пайплайном.
          Оркестрирует шаги: guardrails → retrieval → RRF fusion
          → RBAC filter → rerank → generate → output guardrails.
          I/O-bound, без локального ML-инференса. ADR-005, ADR-008.
        '

        guardrails = component 'Guardrails' {
          technology 'Python + LLM-guard'
          description '
            Шаг 1 (input) и шаг 7 (output).
            Input: prompt injection, PII detection, стоп-паттерны.
            Output: валидация citations, галлюцинации.
          '
        }

        retrieval = component 'Hybrid Retrieval' {
          technology 'Qdrant + Neo4j Cypher'
          description '
            Шаг 2. Гибридный поиск:
            - dense (Qdrant реплика, top-k) — ранжированный список;
            - graph expand (Neo4j реплика, Cypher 1-2 hop) — ранжированный список.
            Возвращает два независимых ранжированных списка для RRF.
          '
          -> embeddingClient                              'encode query (gRPC)'
          -> creditPlatform.graphragRuntime.qdrant_grr    'dense vector search'
          -> creditPlatform.graphragRuntime.neo4j_grr     'Cypher graph expand'
          -> fusion                                       'dense list + graph list'
        }

        fusion = component 'RRF Fusion' {
          technology 'Reciprocal Rank Fusion (k≈60)'
          description '
            Шаг 3. Ранговое слияние dense- и graph-списков по позициям:
            score = Σ 1/(k + rank_i).
            Нивелирует разницу шкал (cosine vs дискретный graph-score). ADR-009.
          '
        }

        rbacFilter = component 'RBAC Filter' {
          technology 'PostgreSQL (replica) + OPA'
          description '
            Шаг 4. Chunk-level RBAC: allowed_roles из PostgreSQL-реплики.
            Политики через Open Policy Agent (подсистема Security). ADR-006.
          '
          -> creditPlatform.graphragRuntime.postgres_grr 'check allowed_roles'
        }

        reranker = component 'Reranker' {
          technology 'Cross-Encoder (через Triton, gRPC)'
          description '
            Шаг 5. Cross-encoder rerank top-N: score(query, chunk) на основе
            глубокого внимания. Финальный порядок контекста перед генерацией.
            Инференс изолирован в Triton. ADR-008, ADR-009.
          '
          -> rerankClient 'rerank pairs (gRPC)'
        }

        llmClient = component 'LLM Client' {
          technology 'OpenAI-compatible API (vLLM)'
          description '
            Шаг 6. Клиент к self-hosted Qwen через vLLM OpenAI API.
            Streaming, retry, timeout. ADR-003, ADR-007.
          '
          -> creditPlatform.graphragRuntime.vllm 'POST /v1/chat/completions'
        }

        embeddingClient = component 'Embedding Client' {
          technology 'gRPC client'
          description '
            Тонкий gRPC-клиент к Triton: encode(query) → dense-вектор.
            Не загружает PyTorch-веса в процесс оркестратора. ADR-008.
          '
          -[grpc]-> creditPlatform.graphragRuntime.inferenceServer 'Embed (gRPC)'
        }

        rerankClient = component 'Rerank Client' {
          technology 'gRPC client'
          description '
            Тонкий gRPC-клиент к Triton: score(query, chunk) cross-encoder.
            Инференс вне процесса оркестратора. ADR-008.
          '
          -[grpc]-> creditPlatform.graphragRuntime.inferenceServer 'Rerank (gRPC)'
        }
      }

      vllm = container 'vLLM Server (Qwen)' {
        technology 'vLLM, Qwen2.5-72B, CUDA'
        description '
          Self-hosted LLM (24+ ГБ VRAM). OpenAI-compatible API.
          Deployment: K8s ns credit-ai-gpu, GPU node pool (bare metal workers).
          ADR-003, ADR-007, ADR-008, ADR-011.
        '
      }

      inferenceServer = container 'Triton Inference Server' {
        technology 'NVIDIA Triton, gRPC, CUDA'
        description '
          GPU inference: embeddings + cross-encoder reranker. Динамический батчинг, gRPC.
          Deployment: K8s ns credit-ai-gpu, GPU node pool. ADR-008, ADR-011.
        '
      }

      postgres_grr = database 'PostgreSQL (replica)' {
        technology 'PostgreSQL 16, streaming replica'
        description '
          Реплика: chunk metadata, RBAC (allowed_roles).
          VM-hosted, только чтение в online-контуре. ADR-011.
        '
        icon tech:postgresql
      }

      qdrant_grr = database 'Qdrant Cluster (replica)' {
        technology 'Qdrant, HNSW'
        description '
          Реплика векторной БД (dim=768+, HNSW cosine).
          VM-hosted, только чтение в online-контуре. ADR-004, ADR-011.
        '
      }

      neo4j_grr = database 'Neo4j Cluster (replica)' {
        technology 'Neo4j 5.x, Cypher'
        description '
          Реплика графового хранилища (Chunk, Document, Company, Risk, Law).
          VM-hosted, только чтение в online-контуре. ADR-007, ADR-011.
        '
      }
    }

    // ═══ Подсистема 2: Knowledge Ingestion Pipeline ═══════════════════════════

    ingestion = subsystem 'Knowledge Ingestion Pipeline' {
      description '
        Offline/batch-контур пополнения базы знаний: документы → чанки →
        эмбеддинги (Triton) → граф → upsert в Qdrant / Neo4j / PostgreSQL.
        Отделён от online-runtime по нагрузке, релизам и ответственности.
      '

      -> creditPlatform.graphragRuntime 'batch embeddings (gRPC, Triton)'
      -[async]-> creditPlatform.graphragRuntime 'DB replication (postgres_i→grr, qdrant_i→grr, neo4j_i→grr)'

      etlOrchestrator = container 'Airflow / ETL Worker' {
        technology 'Python, Apache Airflow'
        description '
          DAG индексации нормативного корпуса и финансовой отчётности.
          Deployment: K8s ns credit-ai-ingestion. ADR-011.
        '
        -> minio_i              'download source documents'
        -[async]-> legalCorpus  'fetch normative documents'
        -[async]-> financialSources 'fetch financial reports'
        -> docParsers           'parse documents'
      }

      docParsers = container 'Document Parsers' {
        technology 'PDF / DOCX / XLSX, layout parser'
        description 'Извлечение текста и структуры из исходных документов.'
        -> chunker 'clean text + layout'
      }

      chunker = container 'Chunker + Metadata Extractor' {
        technology 'LangChain splitter'
        description 'Разбиение на чанки, извлечение метаданных и allowed_roles.'
        -> batchEmbeddings 'chunks'
        -> graphEnrichment 'chunks + entities'
      }

      batchEmbeddings = container 'Batch Embeddings Job' {
        technology 'gRPC client → Triton'
        description '
          Пакетная векторизация чанков через Triton (GPU, динамический батчинг).
          Без локальной загрузки модели. Инференс — через подсистему graphragRuntime. ADR-008.
        '
        -> qdrant_i   'upsert vectors'
        -> postgres_i 'upsert chunk metadata + RBAC'
      }

      graphEnrichment = container 'Graph Enrichment' {
        technology 'Python, Neo4j driver'
        description '
          Построение узлов/рёбер графа знаний:
          Chunk, Document, Company, Risk, Law; BELONGS_TO, MENTIONS, LINKED_TO.
        '
        -> neo4j_i 'upsert nodes/edges'
      }

      postgres_i = database 'PostgreSQL (primary)' {
        technology 'PostgreSQL 16'
        description '
          Источник: chunk metadata, RBAC (allowed_roles), финансовые данные.
          Строится ingestion, реплицируется в graphragRuntime. VM-hosted. ADR-011.
        '
        icon tech:postgresql
      }

      qdrant_i = database 'Qdrant Cluster (primary)' {
        technology 'Qdrant, HNSW'
        description '
          Источник: векторная БД (dim=768+, HNSW cosine).
          Заполняется batch embeddings job. VM-hosted. ADR-004, ADR-011.
        '
      }

      neo4j_i = database 'Neo4j Cluster (primary)' {
        technology 'Neo4j 5.x, Cypher'
        description '
          Источник: граф знаний (Chunk, Document, Company, Risk, Law).
          Строится graph enrichment. VM-hosted. ADR-007, ADR-011.
        '
      }

      minio_i = container 'MinIO' {
        technology 'MinIO S3-compatible'
        description '
          Raw zone: исходные PDF/DOCX. VM-hosted object storage, вне product K8s. ADR-011.
        '
      }
    }

    // ═══ Подсистема 3: AI Quality & MLOps ═════════════════════════════════════

    aiQuality = subsystem 'AI Quality & MLOps' {
      description '
        Контур качества и жизненного цикла моделей: golden set, регрессионные
        прогоны, реестр моделей и промптов, gate перед релизом.
      '

      -> creditPlatform.graphragRuntime 'evaluation query replay'
      -> deliveryPlatform               'promote model version'

      evalRunner = container 'Evaluation Runner' {
        technology 'RAGAS, DeepEval, promptfoo'
        description '
          Прогоны качества: faithfulness, context recall, grounding, формат,
          безопасность, latency. Сравнение baseline / new version.
        '
      }

      goldenSet = container 'Golden Set' {
        technology 'Версионированные датасеты (DVC/Git LFS)'
        description 'Эталонные пары вопрос-ответ и тестовые запросы для регрессии.'
      }

      mlflow = container 'MLflow Tracking + Model Registry' {
        technology 'MLflow'
        description '
          Версии LLM / embeddings / reranker, метрики экспериментов,
          статусы Staging / Production / Archived, model cards.
        '
      }

      promptRegistry = container 'Prompt Registry' {
        technology 'Git-backed registry'
        description 'Версионирование системных промптов и инструкций по citations.'
      }
    }

    // ═══ Подсистема 4: Security & Access Control ══════════════════════════════

    security = subsystem 'Security & Access Control' {
      description '
        Сквозная подсистема безопасности: секреты, политики доступа, аудит.
        Принимает события аудита от graphragRuntime и роли от корпоративной IAM.
      '

      vault = container 'HashiCorp Vault' {
        technology 'HashiCorp Vault'
        description '
          Управление секретами: DB credentials, API keys, TLS/mTLS certs.
          Deployment: Vault Agent в K8s ns credit-ai-app (server — bank infra).
          ADR-007, ADR-011.
        '
      }

      opa = container 'OPA Policy Engine' {
        technology 'Open Policy Agent'
        description 'Политики доступа: какие роли видят какие чанки. K8s ns credit-ai-app. ADR-006, ADR-011.'
      }

      auditLog = container 'Audit Log' {
        technology 'PostgreSQL + append-only store'
        description 'Аудиторский след запросов и решений RBAC по trace_id. Принимает события от graphragRuntime.'
      }

      postgres_s = database 'PostgreSQL (audit)' {
        technology 'PostgreSQL 16, append-only'
        description '
          Хранилище аудиторского следа (append-only).
          Доступ только для security.auditLog. VM-hosted. ADR-011.
        '
        icon tech:postgresql
      }
    }

    // ═══ Подсистема 5: Observability & Reliability ════════════════════════════

    observability = subsystem 'Observability & Reliability' {
      description '
        Метрики, логи, трассировки, алерты, бэкапы и восстановление.
        Эксплуатационная зрелость платформы.
      '

      -[async]-> creditPlatform.ingestion 'backup primary databases (postgres_i, qdrant_i, neo4j_i)'
      -[async]-> creditPlatform.security  'backup audit DB (postgres_s)'

      otelCollector = container 'OTel Collector' {
        technology 'OpenTelemetry Collector'
        description 'Агрегирует трейсы, метрики, логи. K8s ns credit-ai-observability. ADR-007, ADR-011.'
      }

      jaeger = container 'Jaeger' {
        technology 'Jaeger'
        description '
          Распределённая трассировка. Drill-down по trace_id
          от API через retrieval/rerank (Triton) до LLM (vLLM).
        '
      }

      prometheus = container 'Prometheus + Grafana' {
        technology 'Prometheus, Grafana'
        description 'Метрики: latency, throughput, GPU utilization, error rate.'
      }

      alertmanager = container 'Alertmanager' {
        technology 'Alertmanager / PagerDuty'
        description 'Алерты при деградации latency, ошибках инференса, насыщении GPU.'
      }

      backupScheduler = container 'Backup Scheduler' {
        technology 'CronJob / Velero'
        description 'Регулярные бэкапы VM-хранилищ. K8s ns credit-ai-observability (Velero/CronJob). ADR-011.'
      }

      backupStorage = container 'Backup Storage' {
        technology 'Object storage (offsite)'
        description 'Offsite снимки для DR. VM / object storage, вне product K8s. ADR-011.'
      }
    }

  }

  // ─── Внешние platform / governance системы ───────────────────────────────────

  deliveryPlatform = system 'Delivery & Release Platform' {
    description '
      CI/CD платформа банка: сборка, тесты, quality gates, выкатка кода и
      ML-артефактов (образы, версии моделей, промпты), canary и rollback.
    '

    gitRepo = container 'Git Repository' {
      technology 'Git'
      description 'Исходный код, IaC, манифесты деплоя, Architecture-as-Code.'
    }

    ciRunner = container 'CI Runner' {
      technology 'GitHub Actions / GitLab CI'
      description 'Unit / integration / security tests + GenAI quality gates.'
      -> gitRepo           'checkout'
      -> containerRegistry 'push images'
    }

    containerRegistry = container 'Container Registry' {
      technology 'OCI registry'
      description 'Образы FastAPI, vLLM, Triton, ETL.'
    }

    cdController = container 'CD Controller' {
      technology 'Argo CD / Flux'
      description 'GitOps-выкатка: canary / blue-green, rollback кода и моделей.'
      -> containerRegistry 'pull images'
      -> creditPlatform    'deploy / rollback'
    }
  }

  archGovernance = system 'Architecture as Code' {
    description '
      Контур архитектурного управления: версионируемая as-is/to-be модель,
      ADR, линтеры и fitness functions, автогенерация диаграмм, сравнение
      фактических трейсов с запланированной архитектурой.
    '

    archRepo = container 'Architecture Repository' {
      technology 'Git, LikeC4 DSL'
      description 'Исходники Like C4 моделей PoC и MVP, ADR-журнал.'
    }

    adrRepo = container 'ADR Repository' {
      technology 'Markdown ADR'
      description 'Журнал архитектурных решений (000–010).'
    }

    diagramRenderer = container 'Diagram Renderer' {
      technology 'LikeC4 CLI + Playwright'
      description 'Автогенерация PNG-диаграмм из DSL в docs/diagrams.'
      -> archRepo 'read models'
    }

    archLinter = container 'Architecture Linter / Fitness Functions' {
      technology 'LikeC4 checks + custom rules'
      description 'Проверки правил архитектуры и PR/MR quality gate.'
      -> archRepo 'validate model'
    }

    asIsBuilder = container 'As-Is Builder' {
      technology 'OTel trace importer'
      description 'Строит as-is модель из трейсов и сравнивает с to-be.'
      -[async]-> creditPlatform.observability 'import traces'
      -> archRepo                             'compare as-is / to-be'
    }
  }

}
