deployment {

  environment prod 'Production MVP' {
    description '
      On-prem MVP (Q1-Q3 2027): один product Kubernetes-кластер (stateless)
      + Data VMs (stateful). ADR-011.
    '

    k8sCluster = kubernetesCluster 'Product Kubernetes (on-prem)' {
      description '
        Единый product K8s-кластер. GitOps (Argo CD) из deliveryPlatform.
        Worker nodes на VM; GPU node pool — bare metal или GPU-VM.
      '

      nsApp = zone 'ns: credit-ai-app' {
        description 'Online runtime: FastAPI Gateway, RAG Orchestrator, OPA, Vault Agent. Ingress/mTLS через bank ingress.'
        instanceOf creditPlatform.graphragRuntime.apiGateway
        instanceOf creditPlatform.graphragRuntime.ragOrchestrator
        instanceOf creditPlatform.security.opa
        instanceOf creditPlatform.security.vault
      }

      nsGpu = zone 'ns: credit-ai-gpu' {
        description 'Inference: vLLM + Triton. GPU node pool (CUDA, gRPC). ADR-008.'
        instanceOf creditPlatform.graphragRuntime.vllm
        instanceOf creditPlatform.graphragRuntime.inferenceServer
      }

      nsIngestion = zone 'ns: credit-ai-ingestion' {
        description 'Offline/batch: Airflow, parsers, chunker, batch embeddings, graph enrichment.'
        instanceOf creditPlatform.ingestion.etlOrchestrator
        instanceOf creditPlatform.ingestion.docParsers
        instanceOf creditPlatform.ingestion.chunker
        instanceOf creditPlatform.ingestion.batchEmbeddings
        instanceOf creditPlatform.ingestion.graphEnrichment
      }

      nsObservability = zone 'ns: credit-ai-observability' {
        description 'OTel, Jaeger, Prometheus/Grafana, Alertmanager, backup scheduler (Velero/CronJob).'
        instanceOf creditPlatform.observability.otelCollector
        instanceOf creditPlatform.observability.jaeger
        instanceOf creditPlatform.observability.prometheus
        instanceOf creditPlatform.observability.alertmanager
        instanceOf creditPlatform.observability.backupScheduler
      }
    }

    dataVms = vmHost 'Data VMs (stateful)' {
      description '
        VM-hosted хранилища вне product K8s. Bank infra / DBA.
        Подключение из K8s pods по internal network.
      '

      dbTierPrimary = zone 'DB Tier Primary (VM)' {
        description 'Первичные БД ingestion: PostgreSQL, Neo4j, Qdrant. Audit PostgreSQL (security).'
        instanceOf creditPlatform.ingestion.postgres_i
        instanceOf creditPlatform.ingestion.neo4j_i
        instanceOf creditPlatform.ingestion.qdrant_i
        instanceOf creditPlatform.security.postgres_s
      }

      dbTierReplica = zone 'DB Tier Replica (VM)' {
        description 'Реплики для online-runtime graphragRuntime: PostgreSQL, Neo4j, Qdrant. Только чтение.'
        instanceOf creditPlatform.graphragRuntime.postgres_grr
        instanceOf creditPlatform.graphragRuntime.neo4j_grr
        instanceOf creditPlatform.graphragRuntime.qdrant_grr
      }

      objectStorage = zone 'Object Storage (VM)' {
        description 'MinIO raw zone (ingestion), offsite backup storage.'
        instanceOf creditPlatform.ingestion.minio_i
        instanceOf creditPlatform.observability.backupStorage
      }
    }

  }

}

views {

  deployment view mvp_deployment {
    title 'MVP: Deployment — K8s + Data VMs'
    description '
      Deployment MVP (ADR-011):
      Product Kubernetes (namespaces: app+rag, gpu, ingestion, observability)
      + Data VMs (Primary: PostgreSQL/Neo4j/Qdrant ingestion + audit;
                  Replica: PostgreSQL/Neo4j/Qdrant graphragRuntime;
                  Object: MinIO + backup).
      Один K8s-кластер; GPU — node pool; CI/CD — внешняя deliveryPlatform.
    '
    includeAncestors: true
    include prod.**
  }

}
