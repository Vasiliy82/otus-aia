views {

  dynamic view mvp_ask_sequence {
    title 'MVP: Sequence — POST /ask'
    description '
      User → Guardrails → hybrid retrieval (Qdrant + Neo4j) → RRF fusion
      → RBAC → cross-encoder rerank (Triton, gRPC) → LLM (vLLM/Qwen).

      Тяжёлый инференс (embeddings, cross-encoder) изолирован в Triton по gRPC;
      FastAPI остаётся I/O-bound. Ранжирование: RRF + cross-encoder вместо
      эвристики. Трассировка OTel. ADR-008, ADR-009.
    '
    variant sequence

    creditAnalyst
      -> creditPlatform.graphragRuntime.apiGateway.apiLayer 'POST /ask {query, role}' {
      notes '''
        **Входной запрос**

        Передаём:
        - `query` — текст вопроса
        - `role` — роль пользователя для RBAC-фильтрации

        API запускает LangGraph workflow.
        FastAPI не загружает ML-модели — только gRPC-каналы к Triton/vLLM.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.guardrails 'input guardrails' {
      notes '''
        **Проверка входа**

        Guardrails проверяют:
        - prompt injection и стоп-паттерны
        - обнаружение PII
        - формат входных данных и ограничения роли
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.retrieval 'hybrid retrieve' {
      notes '''
        **Гибридный поиск**

        Retrieval запускает два независимых пути и собирает два
        ранжированных списка для последующего RRF-слияния.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.embeddingClient 'encode query' {
      notes '''
        **Векторизация запроса**

        Тонкий gRPC-клиент вызывает Triton — без загрузки модели в процесс
        FastAPI (не блокируем GIL). ADR-008.
      '''
    }
      -> creditPlatform.graphragRuntime.inferenceServer 'Embed (gRPC)' {
      notes '''
        **Triton: embeddings**

        Triton на GPU с динамическим батчингом отдаёт dense-вектор запроса.
        Конкурентные запросы не блокируют друг друга.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.retrieval 'query vector' {
      notes '**Вектор готов** — продолжаем dense- и graph-поиск.'
    }
      -> creditPlatform.qdrant 'dense search (top-k)' {
      notes '**Dense-список** — top-k по косинусному сходству (HNSW).'
    }
      -> creditPlatform.neo4j 'graph expand (Cypher 1-2 hop)' {
      notes '**Graph-список** — связанные чанки через BELONGS_TO / MENTIONS / LINKED_TO.'
    }
      -> creditPlatform.graphragRuntime.apiGateway.fusion 'RRF fusion' {
      notes '''
        **RRF — ранговое слияние**

        score = Σ 1/(k + rank_i), k≈60. Работает с позициями, а не с
        абсолютными скорами — нивелирует разницу шкал dense vs graph.
        Заменяет эвристику `vector + 0.5·graph`. ADR-009.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.rbac 'rbac_filter' {
      notes '''
        **RBAC-фильтрация**

        Удаляем чанки, недоступные роли: allowed_roles из PostgreSQL,
        политика через OPA. Обязательный узел графа. ADR-006.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.reranker 'rerank top-N' {
      notes '''
        **Cross-encoder rerank**

        Top-N кандидатов после RRF переранжируются cross-encoder’ом
        score(query, chunk) на основе глубокого внимания. ADR-009.
      '''
    }
      -> creditPlatform.graphragRuntime.inferenceServer 'Rerank (gRPC)' {
      notes '''
        **Triton: cross-encoder**

        Cross-encoder инференс изолирован в Triton (GPU, gRPC). FastAPI
        не выполняет CPU-bound скоринг. ADR-008.
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.llmClient 'generate_answer' {
      notes '''
        **Подготовка промпта**

        LLM Client формирует запрос к vLLM:
        - отранжированный контекст после RBAC и cross-encoder
        - системный промпт и инструкции по citations
      '''
    }
      -> creditPlatform.graphragRuntime.vllm 'POST /v1/chat/completions' {
      notes '''
        **Вызов LLM**

        Self-hosted Qwen через vLLM:
        - OpenAI-compatible API
        - генерация ответа на отдельном GPU-сервере
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.llmClient 'stream response' {
      notes '''
        **Стриминг ответа**

        LLM Client получает поток токенов от vLLM:
        - сбор полного текста ответа
        - retry и timeout при сбоях
      '''
    }
      -> creditPlatform.graphragRuntime.apiGateway.guardrails 'output guardrails' {
      notes '''
        **Проверка выхода**

        Output guardrails проверяют:
        - валидность citations
        - признаки галлюцинаций
        - блокировку ответа без источников
      '''
    }
      -> creditAnalyst 'answer + citations' {
      notes '''
        **Ответ + трассировка**

        Клиент получает:
        - `answer` и `citations`
        - `trace_id` для drill-down в Jaeger (OpenTelemetry)
        - `blocked` — флаг блокировки ответа
      '''
    }

    include
      creditAnalyst,
      creditPlatform.graphragRuntime.apiGateway.apiLayer,
      creditPlatform.graphragRuntime.apiGateway.guardrails,
      creditPlatform.graphragRuntime.apiGateway.retrieval,
      creditPlatform.graphragRuntime.apiGateway.embeddingClient,
      creditPlatform.graphragRuntime.apiGateway.fusion,
      creditPlatform.graphragRuntime.apiGateway.rbac,
      creditPlatform.graphragRuntime.apiGateway.reranker,
      creditPlatform.graphragRuntime.apiGateway.llmClient,
      creditPlatform.graphragRuntime.inferenceServer,
      creditPlatform.graphragRuntime.vllm,
      creditPlatform.qdrant,
      creditPlatform.neo4j
  }

}
