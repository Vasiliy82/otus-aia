specification {

  element actor {
    notation "Person"
    style {
      shape person
      color green
    }
  }

  element system {
    notation "Software System"
    style {
      opacity 20%
    }
  }

  element external-system {
    notation "External Software System"
    style {
      opacity 20%
      color muted
    }
  }

  element subsystem {
    notation "Subsystem"
    style {
      opacity 25%
      color indigo
    }
  }

  element container {
    notation "Container"
  }

  element database {
    notation "Database"
    style {
      shape cylinder
      color sky
    }
  }

  element queue {
    notation "Message Queue"
    style {
      shape queue
      color amber
    }
  }

  element component {
    notation "Component"
    style {
      opacity 20%
    }
  }

  element pgTable {
    notation "PostgreSQL Table"
    style {
      shape storage
      color sky
    }
  }

  element datastoreEntity {
    notation "Logical Entity"
    style {
      shape storage
      color indigo
    }
  }

  deploymentNode environment {
    notation "Environment"
    style {
      opacity 15%
    }
  }

  deploymentNode zone {
    notation "Deployment Zone"
    style {
      opacity 10%
    }
  }

  relationship async {
    line dashed
  }

  relationship grpc {
    line solid
    head normal
  }

}
