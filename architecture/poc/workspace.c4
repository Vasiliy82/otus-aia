specification {

  element actor {
    notation "Person"
    style {
      shape person
      color green
    }
  }

  element system {
    notation "Software System"
    style {
      opacity 20%
    }
  }

  element external-system {
    notation "External Software System"
    style {
      opacity 20%
      color muted
    }
  }

  element container {
    notation "Container"
  }

  element database {
    notation "Database"
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    notation "Component"
    style {
      opacity 20%
    }
  }

  element pgTable {
    notation "PostgreSQL Table"
    style {
      shape storage
      color sky
    }
  }

  deploymentNode environment {
    notation "Environment"
    style {
      opacity 15%
    }
  }

  deploymentNode zone {
    notation "Deployment Zone"
    style {
      opacity 10%
    }
  }

  relationship async {
    line dashed
  }

}
